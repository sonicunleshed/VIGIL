{
  "name": "@vigil/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the VIGIL FastAPI OpenAPI document.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "openapi": "cd ../../services/api && uv run python -m app.openapi_dump > ../../packages/contracts/openapi.json",
    "gen": "pnpm openapi && openapi-typescript openapi.json -o src/api.d.ts",
    "check": "pnpm gen && git diff --exit-code -- openapi.json src/api.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5"
  }
}
